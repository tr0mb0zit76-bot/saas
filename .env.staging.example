# Staging / combat-test host — copy to .env on the server (never commit real .env).
# Topology: docs/architecture/decisions/ADR-014-staging-topology.md
# Checklist: docs/sync/staging-checklist.md

APP_NAME="Traklo Pro"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://REPLACE_CRM_DOMAIN
FORCE_HTTPS=true

CRM_DOMAIN=REPLACE_CRM_DOMAIN
SHOWCASE_DOMAIN=REPLACE_CRM_DOMAIN
SHOWCASE_MODE=traklo_pro
PLATFORM_DOMAIN=platform.REPLACE_CRM_DOMAIN

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Europe/Samara
DISPOSITION_TIMEZONE=Europe/Samara

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saas_crm_staging
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.REPLACE_CRM_DOMAIN
SESSION_SECURE_COOKIE=true

SECURITY_HEADERS_CSP_ENABLED=true

QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@REPLACE_CRM_DOMAIN"
MAIL_FROM_NAME="${APP_NAME}"

DOC_PREVIEW_DRIVER=gotenberg
GOTENBERG_URL=http://127.0.0.1:3000
GOTENBERG_TIMEOUT=60

FILESYSTEM_DISK=local
DOCUMENT_STORAGE=local
TENANT_STORAGE_DISK=tenant_s3
TENANT_STORAGE_FOR_DOCUMENTS=true
# TENANT_STORAGE_ROOT_PREFIX=traklo-pro-staging
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ru-central1
AWS_BUCKET=
AWS_ENDPOINT=https://storage.yandexcloud.net
AWS_USE_PATH_STYLE_ENDPOINT=true

SAAS_DEFAULT_TENANT_SLUG=demo
SAAS_PLATFORM_ADMIN_EMAILS=platform-admin@REPLACE_CRM_DOMAIN
SAAS_TRIAL_DAYS=14
# Prefer invite-only on staging unless demo is intentional
SAAS_DEMO_SIGNUP_ENABLED=false
# Keep AA Astral/1C-Fresh stubs off (ADR-015)
SAAS_LEGACY_AA_INTEGRATIONS=false

VITE_APP_NAME="${APP_NAME}"
